{
  "name": "screen-go",
  "version": "1.0.0",
  "private": true,
  "main": "appDir/main/main.js",
  "author": "iLx1",
  "description": "图片取模软件",
  "scripts": {
    "start": "vite && electron .",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "prune:ffmpeg": "node scripts/prune-ffmpeg-platforms.mjs",
    "electron:build": "rimraf dist dist_electron && pnpm build-only && pnpm prune:ffmpeg && electron-builder -wml --x64",
    "electron:build:win": "rimraf dist dist_electron && pnpm build-only && pnpm prune:ffmpeg && electron-builder --win",
    "electron:build:mac": "rimraf dist dist_electron && pnpm build-only && pnpm prune:ffmpeg && electron-builder --mac",
    "electron:build:linux": "rimraf dist dist_electron && pnpm build-only && pnpm prune:ffmpeg && electron-builder --linux",
    "build:icons": "electron-icon-builder --input=./public/icon.png --output=./public/ --flatten"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@ts-ffmpeg/fluent-ffmpeg": "^2.2.6",
    "codemirror": "^5.65.21",
    "codemirror-editor-vue3": "^2.8.0",
    "electron-store": "^8.1.0",
    "es-toolkit": "^1.44.0",
    "fs-extra": "^11.1.0",
    "ilx1-x-box": "^1.0.0",
    "ilx1-x-tool": "^1.2.6",
    "pinia": "^2.1.6",
    "tui-image-editor": "^3.15.3"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/codemirror": "^5.60.17",
    "@types/node": "^18.17.17",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/tsconfig": "^0.4.0",
    "electron": "42.4.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "fast-glob": "^3.3.3",
    "ilx1-x-style": "^1.1.2",
    "naive-ui": "^2.43.2",
    "npm-run-all2": "^6.0.6",
    "rimraf": "^5.0.5",
    "sass": "^1.89.0",
    "sass-loader": "^13.3.3",
    "typescript": "~5.2.0",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue-tsc": "^1.8.11"
  },
  "build": {
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "appId": "com.xxx.ScreenGo",
    "productName": "ScreenGo",
    "copyright": "Copyright © 2023 iLx1",
    "directories": {
      "output": "dist_electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iLx11",
        "repo": "screen-go"
      }
    ],
    "win": {
      "icon": "./public/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "icon": "./public/icons",
      "mimeTypes": [
        "x-scheme-handler/screen-go"
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "iLx1 <your@email.com>",
      "synopsis": "Multi-Pad Application",
      "description": "Cross-platform multi-functional pad application",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "icon": "./public/icons/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150
        }
      ]
    },
    "files": [
      "./dist",
      "./electron",
      "./appDir"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/electron-store/**/*",
      "**/node_modules/@ffmpeg-installer/**/*",
      "**/node_modules/@ffprobe-installer/**/*",
      "**/node_modules/.pnpm/@ffmpeg-installer+*/**/*",
      "**/node_modules/.pnpm/@ffprobe-installer+*/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/icons/icon.ico",
      "uninstallerIcon": "./public/icons/icon.ico",
      "installerHeaderIcon": "./public/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
